---
/**
 * Self-hosted fonts (Fontsource), only the cyrillic + latin subsets.
 * Headings: Geologica variable, all axes (wght, slnt, CRSV, SHRP) — preloaded.
 * Body: Onest variable (wght). Notes: Caveat 500.
 * Note: Russian text still needs the latin subset (digits, punctuation, spaces).
 */
import geoCyr from '@fontsource-variable/geologica/files/geologica-cyrillic-full-normal.woff2?url';
import geoLat from '@fontsource-variable/geologica/files/geologica-latin-full-normal.woff2?url';
import onestCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import caveatCyr from '@fontsource/caveat/files/caveat-cyrillic-500-normal.woff2?url';
import caveatLat from '@fontsource/caveat/files/caveat-latin-500-normal.woff2?url';

const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LAT =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const face = (family: string, src: string, range: string, variable: boolean, weight = '100 900', extra = '') => `
@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};
src:url(${src}) format('${variable ? 'woff2-variations' : 'woff2'}');unicode-range:${range};${extra}}`;

const css = [
  face('Geologica', geoCyr, CYR, true),
  face('Geologica', geoLat, LAT, true),
  face('Onest', onestCyr, CYR, true),
  face('Onest', onestLat, LAT, true),
  face('Caveat', caveatCyr, CYR, false, '500'),
  face('Caveat', caveatLat, LAT, false, '500'),
  // metric-adjusted fallbacks keep layout shift small while fonts swap in
  `@font-face{font-family:'Onest Fallback';src:local('Arial');size-adjust:104%;ascent-override:92%;descent-override:24%}`,
  `@font-face{font-family:'Geologica Fallback';src:local('Arial');size-adjust:108%;ascent-override:90%;descent-override:24%}`,
].join('');
---

<link rel="preload" href={geoCyr} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geoLat} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
