---
/**
 * Shared SVG filters, rendered once per page.
 *  #boil     — line boil for SVG drawings (seed stepped at ~10 fps by scripts/boil.ts)
 *  #boil-ui  — same, tuned for HTML elements (focus rings, hand-drawn underlines)
 *  #still-ui — #boil-ui frozen in one frame (resting UI outlines)
 *  #glass    — wobbly-glass hover for images / card media
 * Sprayed edges of colour shapes are pre-rendered mask images (styles/masks), not live filters.
 */
---

<svg class="art-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <filter id="boil" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.032" numOctaves="2" seed="3" data-boil></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="3.4" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="boil-ui" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="5" data-boil></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="3" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <!-- same displacement, but frozen: hand-drawn UI outlines that don't boil until hovered -->
    <filter id="still-ui" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="5"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="3" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
    <filter id="glass" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
      <feTurbulence type="turbulence" baseFrequency="0.011 0.019" numOctaves="2" seed="4">
        <animate attributeName="baseFrequency" dur="9s" values="0.011 0.019;0.015 0.025;0.011 0.019" repeatCount="indefinite"></animate>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="14" xChannelSelector="R" yChannelSelector="B"></feDisplacementMap>
    </filter>
  </defs>
</svg>

<style>
  .art-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>
