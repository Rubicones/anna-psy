---
/**
 * Fixed living gradient behind all content. The WebGL canvas fades in over a
 * static CSS gradient that uses the same palette (also the no-WebGL / no-JS fallback).
 */
import { daytimes, type Daytime } from '~/lib/palette';

interface Props {
  /** palette for the very first paint, before JS runs */
  initial?: Daytime;
}
const { initial = 'sea' } = Astro.props;
const init = daytimes[initial].map((c, i) => `--f${i}:${c}`).join(';');
---

<div class="field" data-field style={init} aria-hidden="true">
  <div class="field__fallback"></div>
  <canvas class="field__canvas"></canvas>
</div>

<style>
  .field {
    position: fixed;
    inset: 0 0 auto 0;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    background: var(--f0);
  }
  .field__fallback,
  .field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* soft defocused blobs in CSS (no grain: the shader is the only full-screen grain) */
  .field__fallback {
    background:
      radial-gradient(38% 42% at 72% 28%, color-mix(in srgb, var(--f4) 90%, transparent), transparent 70%),
      radial-gradient(46% 40% at 22% 68%, color-mix(in srgb, var(--f3) 85%, transparent), transparent 72%),
      radial-gradient(55% 50% at 80% 82%, color-mix(in srgb, var(--f2) 80%, transparent), transparent 70%),
      radial-gradient(60% 60% at 30% 20%, var(--f1), transparent 75%),
      var(--f0);
    filter: blur(24px) saturate(1.05);
    scale: 1.1;
  }
  .field__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-soft);
  }
  :global(.field--gl.field--ready) .field__canvas {
    opacity: 1;
  }
  /* dev toolbar: field switched off → CSS fallback only */
  :global(.field--off) .field__canvas {
    opacity: 0 !important;
  }
</style>
