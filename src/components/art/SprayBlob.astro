---
/**
 * A soft colour blob with a sprayed, speckled edge and pigment texture.
 * Edge: three pre-rendered mask layers (.spray-shape) — soft body, spray dots, no live filters.
 * Purely decorative. Size it with width/height via `style` or a class.
 */
import { colorVar, type PaletteName } from '~/lib/palette';

interface Props {
  tone?: PaletteName;
  /** second colour for the inner glow */
  glow?: PaletteName;
  shape?: 'a' | 'b' | 'c';
  rotate?: number;
  /** > 0 = defocused variant (softer body and halo) */
  blur?: number;
  class?: string;
  style?: string;
}
const { tone = 'sun', glow, shape = 'a', rotate = 0, blur = 0, class: className, style } = Astro.props;
const vars = [
  `--bg:${colorVar(tone)}`,
  glow && `--glow:${colorVar(glow)}`,
  `--core:var(--core-${shape}${blur ? '-soft' : ''})`,
  `--halo:var(--halo-${shape}${blur ? '-soft' : ''})`,
  `--rot:${rotate}deg`,
  style,
]
  .filter(Boolean)
  .join(';');
---

<span class:list={['spray-blob', 'spray-shape', className]} style={vars} aria-hidden="true"></span>

<style>
  .spray-blob {
    display: block;
    rotate: var(--rot);
    /* the masked body fills ~75% of the box; scale up so blobs keep their old visual size */
    scale: 1.3;
    background-color: var(--bg);
    background-image:
      var(--tex-pigment),
      radial-gradient(60% 55% at 38% 34%, color-mix(in srgb, var(--glow, var(--c-white)) calc(var(--blob-glow) * 100%), transparent), transparent 70%);
    background-size: var(--tex-pigment-size), 100% 100%;
  }
</style>
