---
/** Sparse spray-paint splatter dots. Seasoning, not decoration: keep `count` low. */
import { palette } from '~/lib/palette';
import { splatter } from '~/lib/wobble';

interface Props {
  seed?: number;
  count?: number;
  /** viewBox size; the SVG stretches to its box */
  w?: number;
  h?: number;
  class?: string;
  style?: string;
}
const { seed = 1, count = 14, w = 400, h = 300, class: className, style } = Astro.props;
const dots = splatter(seed, count, w, h, [palette.splatRed, palette.splatBlue, palette.splatGreen]);
---

<svg class:list={['splatter', className]} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" style={style}>
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.fill} />)}
</svg>

<style>
  .splatter {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  circle {
    opacity: 0.85;
  }
</style>
