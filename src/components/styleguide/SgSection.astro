---
import type { Daytime } from '~/lib/palette';

interface Props {
  id: string;
  n: string;
  title: string;
  daytime: Daytime;
  class?: string;
}
const { id, n, title, daytime, class: className } = Astro.props;
---

<section class:list={['sg', 'defer-render', className]} id={id} data-daytime={daytime} aria-labelledby={`${id}-h`}>
  <header class="sg__head wrap">
    <p class="sg__n hand" aria-hidden="true">{n}</p>
    <div class="sg__title text-glow">
      <h2 id={`${id}-h`}>{title}</h2>
      <div class="sg__intro prose"><slot name="intro" /></div>
    </div>
  </header>
  <div class="sg__body wrap"><slot /></div>
</section>

<style>
  .sg {
    position: relative;
    padding-block: var(--space-5) var(--space-4);
  }
  .sg__head {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.5rem 1rem;
    margin-bottom: var(--space-4);
  }
  .sg__n {
    font-size: clamp(3rem, 2rem + 5vw, 6.5rem);
    line-height: 0.8;
    color: var(--c-white);
    rotate: -6deg;
    translate: 0 -0.15em;
    text-shadow: 0 2px 18px rgb(var(--c-ink-rgb) / 0.12);
  }
  .sg__title {
    max-width: 52rem;
    padding-top: 0.6rem;
  }
  .sg__intro:not(:empty) {
    margin-top: 0.9rem;
  }
  .sg__intro :global(p) {
    max-width: 62ch;
  }
</style>
