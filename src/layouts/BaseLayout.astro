---
import '~/styles/global.css';
import ArtDefs from '~/components/art/ArtDefs.astro';
import GradientField from '~/components/art/GradientField.astro';
import DevToolbar from '~/components/dev/DevToolbar.astro';
import Fonts from '~/components/Fonts.astro';
import { cssVars, palette, type Daytime } from '~/lib/palette';
import { site } from '~/site.config';

interface Props {
  title?: string;
  description?: string;
  /** palette of the first screen */
  daytime?: Daytime;
  noindex?: boolean;
}

const { title, description = site.description, daytime = 'sea', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name}, ${site.role}`;
const rootVars = `:root{${cssVars()}}`;
---

<!doctype html>
<html lang={site.lang} class="no-js" data-daytime={daytime}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={palette.paper} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // js flag + device quality tier (high = desktop, mid = phone/tablet, low = weak phone).
      // Read by CSS (html[data-quality]) and by scripts/bg.ts. Override for testing: ?quality=low
      (function () {
        var d = document.documentElement, n = navigator;
        d.classList.replace('no-js', 'js');
        var forced = /[?&]quality=(high|mid|low)/.exec(location.search);
        var coarse = matchMedia('(pointer: coarse)').matches;
        var weak = (n.deviceMemory || 8) <= 4 || (n.hardwareConcurrency || 8) <= 4 || (n.connection && n.connection.saveData);
        d.dataset.quality = forced ? forced[1] : !coarse ? 'high' : weak ? 'low' : 'mid';
        // mirror of tierOverrides in scripts/bg.ts for the CSS-driven switches, so the first paint is already light
        d.classList.add('bg-no-frost');
        if (d.dataset.quality !== 'high') d.classList.add('bg-no-draw-filter');
        if (d.dataset.quality === 'low') d.classList.add('bg-no-life', 'bg-mask-spray');
      })();
    </script>
    <Fonts />
    <style is:inline set:html={rootVars}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <ArtDefs />
    <GradientField initial={daytime} />
    <slot />
    <script>
      import '~/scripts/art';
    </script>
    {import.meta.env.DEV && <DevToolbar />}
  </body>
</html>
