---
/**
 * /styleguide — phase 1: the art direction lives here.
 * Not linked from the site; noindex.
 */
import { getCollection } from 'astro:content';
import type { IlloName } from '~/art';
import HandDivider from '~/components/art/HandDivider.astro';
import Illustration from '~/components/art/Illustration.astro';
import Splatter from '~/components/art/Splatter.astro';
import SprayBlob from '~/components/art/SprayBlob.astro';
import WavyEdge from '~/components/art/WavyEdge.astro';
import SgSection from '~/components/styleguide/SgSection.astro';
import Accordion from '~/components/ui/Accordion.astro';
import BlobCard from '~/components/ui/BlobCard.astro';
import Button from '~/components/ui/Button.astro';
import HandUnderline from '~/components/ui/HandUnderline.astro';
import PaperCard from '~/components/ui/PaperCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { colorVar, contrast, daytimes, palette, type Daytime, type PaletteName } from '~/lib/palette';
import { site } from '~/site.config';

const faq = await getCollection('faq');

const swatches: { key: PaletteName; name: string; role: string; group: string }[] = [
  { key: 'sun', name: 'солнце', role: 'главный тёплый', group: 'Тёплые — 60–70% цвета' },
  { key: 'orange', name: 'апельсин', role: 'CTA, акценты', group: 'Тёплые — 60–70% цвета' },
  { key: 'coral', name: 'коралл', role: 'акцент, подчёркивания', group: 'Тёплые — 60–70% цвета' },
  { key: 'peach', name: 'персик', role: 'ореолы, мягкий фон', group: 'Тёплые — 60–70% цвета' },
  { key: 'sky', name: 'небо', role: 'воздух', group: 'Холодные — пространство для дыхания' },
  { key: 'turquoise', name: 'бирюза', role: 'море', group: 'Холодные — пространство для дыхания' },
  { key: 'mint', name: 'мята', role: 'луг, спокойные карточки', group: 'Холодные — пространство для дыхания' },
  { key: 'lavender', name: 'лаванда', role: 'закат, сумерки', group: 'Холодные — пространство для дыхания' },
  { key: 'olive', name: 'олива', role: 'трава, стебли', group: 'Холодные — пространство для дыхания' },
];
const groups = [...new Set(swatches.map((s) => s.group))];

const fills: PaletteName[] = ['paper', 'sun', 'peach', 'orange', 'coral', 'mint', 'sky', 'turquoise', 'lavender', 'olive'];
const ratio = (a: string, b: string) => contrast(a, b);
const grade = (r: number) => (r >= 4.5 ? 'AA' : r >= 3 ? 'AA крупный' : 'нет');

const daytimeLabels: Record<Daytime, { name: string; where: string }> = {
  sea: { name: 'Тёплое море', where: 'приветствие' },
  meadow: { name: 'Луг', where: 'обо мне, подходы' },
  sunset: { name: 'Закат', where: 'запись, образование' },
  dusk: { name: 'Сумерки', where: 'футер' },
};

const illos: { name: IlloName; ru: string; tile: PaletteName; glow?: PaletteName; filled?: string }[] = [
  { name: 'sevenPetal', ru: 'семь лепестков', tile: 'turquoise', glow: 'lavender' },
  { name: 'chamomile', ru: 'ромашка', tile: 'olive', glow: 'mint' },
  { name: 'tulip', ru: 'тюльпан', tile: 'coral', glow: 'sun' },
  { name: 'fern', ru: 'папоротник', tile: 'mint', glow: 'sky' },
  { name: 'cat', ru: 'кот', tile: 'orange', glow: 'sun' },
  { name: 'heron', ru: 'цапля', tile: 'sky', glow: 'peach' },
  { name: 'snail', ru: 'улитка', tile: 'lavender', glow: 'peach' },
  { name: 'bird', ru: 'птичка', tile: 'sun', glow: 'peach' },
  { name: 'grassTuft', ru: 'трава', tile: 'olive', glow: 'sun' },
  { name: 'sun', ru: 'солнце', tile: 'coral', glow: 'sun' },
  { name: 'moon', ru: 'месяц', tile: 'lavender', glow: 'sky' },
  { name: 'star', ru: 'звезда', tile: 'turquoise', glow: 'sun' },
  { name: 'heart', ru: 'сердце', tile: 'peach', glow: 'coral' },
];

const nav = [
  ['#palette', 'Палитра'],
  ['#type', 'Шрифты'],
  ['#grain', 'Зерно'],
  ['#field', 'Поле'],
  ['#illustrations', 'Рисунки'],
  ['#components', 'Компоненты'],
  ['#composition', 'Композиция'],
] as const;
---

<BaseLayout title="Стайлгайд" daytime="sea" noindex>
  <header class="sg-top">
    <nav class="sg-nav frost wrap" aria-label="Разделы стайлгайда">
      <a class="sg-nav__home hand" href="/">{site.name.split(' ')[0]}</a>
      <ul>
        {
          nav.map(([href, label], i) => (
            <li>
              <HandUnderline href={href} seed={i * 5 + 3} current={i === 0}>
                {label}
              </HandUnderline>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main">
    <!-- ───────────── intro ───────────── -->
    <section class="intro wrap" data-daytime="sea" aria-labelledby="intro-h">
      <div class="intro__flower" aria-hidden="true">
        <Illustration name="sevenPetal" size={420} ink={4} draw class="intro__petal" />
      </div>
      <div class="intro__text text-glow">
        <p class="eyebrow">фаза 1 · арт-дирекшн</p>
        <h1 id="intro-h" class="h-display">Стайлгайд</h1>
        <p class="lead intro__lead">
          Сайт должен ощущаться как скетчбук спокойного тёплого человека летним вечером. Здесь собрано всё, из чего он будет сделан, — до того, как появятся
          секции.
        </p>
      </div>
    </section>

    <!-- ───────────── 01 palette ───────────── -->
    <SgSection id="palette" n="01" title="Палитра" daytime="sea">
      <Fragment slot="intro">
        <p>
          Тёплые цвета занимают большую часть цветной площади, холодные — воздух между ними. Фон — тёплая бумага, никогда не чисто белый. Брызги красного, синего и
          зелёного — только крошечные точки, как специи.
        </p>
      </Fragment>

      {
        groups.map((g) => (
          <div class="swatch-group">
            <h3 class="h4 swatch-group__h text-glow">{g}</h3>
            <ul class="swatches" role="list">
              {swatches
                .filter((s) => s.group === g)
                .map((s, i) => (
                  <li class="swatch">
                    <SprayBlob tone={s.key} shape={(['a', 'b', 'c'] as const)[i % 3]} rotate={i * 23 - 20} class="swatch__blob" />
                    <div class="swatch__label text-glow">
                      <span class="swatch__name">{s.name}</span>
                      <code class="swatch__hex">{palette[s.key]}</code>
                      <span class="swatch__role small">{s.role}</span>
                    </div>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }

      <div class="base-row">
        <div class="base-card text-glow">
          <h3 class="h4">Основа и чернила</h3>
          <div class="base-pair">
            <span class="chip" style={`background:${palette.paper}`}></span>
            <span><b>бумага</b> <code>{palette.paper}</code> — все фоны</span>
          </div>
          <div class="base-pair">
            <span class="chip" style={`background:${palette.ink}`}></span>
            <span><b>чернила</b> <code>{palette.ink}</code> — весь текст</span>
          </div>
          <div class="base-pair">
            <span class="chip chip--white"></span>
            <span><b>белый</b> — линии рисунков поверх цвета</span>
          </div>
        </div>
        <div class="base-card base-card--splat text-glow">
          <Splatter seed={7} count={26} w={320} h={180} />
          <h3 class="h4">Брызги</h3>
          <p class="small">
            <code>{palette.splatRed}</code> · <code>{palette.splatBlue}</code> · <code>{palette.splatGreen}</code><br />
            только точки до 4 px, 10–30 штук на экран
          </p>
        </div>
      </div>

      <div class="contrast">
        <h3 class="h4 text-glow contrast__h">Контраст текста (WCAG 2.x, посчитано при сборке)</h3>
        <div class="contrast__table text-glow">
        <div class="contrast__scroll" tabindex="0" role="region" aria-label="Таблица контраста">
          <table>
            <thead>
              <tr>
                <th scope="col">Фон</th>
                <th scope="col">Чернила</th>
                <th scope="col">Белый</th>
              </tr>
            </thead>
            <tbody>
              {
                fills.map((f) => {
                  const ri = ratio(palette.ink, palette[f]);
                  const rw = ratio(palette.white, palette[f]);
                  return (
                    <tr>
                      <th scope="row">
                        <span class="chip chip--sm" style={`background:${palette[f]}`} />
                        {f}
                      </th>
                      <td class:list={{ ok: ri >= 4.5 }}>
                        {ri.toFixed(1)} · {grade(ri)}
                      </td>
                      <td class:list={{ ok: rw >= 4.5, meh: rw >= 3 && rw < 4.5 }}>
                        {rw.toFixed(1)} · {grade(rw)}
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
        </div>
        <div class="decision text-glow">
          <p class="hand decision__tag">на утверждение</p>
          <p>
            Белый не дотягивает до 3:1 на наших светлых полях, а поле ещё и плывёт. Поэтому <b>белый — только для линий рисунков и декоративных подписей</b>,
            весь читаемый текст — чернилами прямо на поле. Там, где поле темнеет (глубокое море, сумерки), под текстом мягкое светлое свечение без краёв — не
            плашка, а свет. Его сила — один токен <code>--glow-a</code>.
          </p>
        </div>
      </div>
    </SgSection>

    <!-- ───────────── 02 type ───────────── -->
    <SgSection id="type" n="02" title="Шрифты" daytime="meadow">
      <Fragment slot="intro">
        <p>
          <b>Geologica</b> — заголовки: переменный гротеск с осями насыщенности, наклона и «курсивности» (CRSV). Острота (SHRP) всегда 0 — так буквы мягче. <b
            >Onest</b
          > — основной текст. <b>Caveat</b> — заметки на полях, редко. Все три с кириллицей, грузятся с сайта (Fontsource), только кириллица и латиница.
        </p>
      </Fragment>

      <div class="type-grid">
        <div class="type-specimen text-glow">
          <p class="h-display type-specimen__display">Анна</p>
          <h3 class="h1">Летний вечер</h3>
          <p class="h2">Как проходит сессия</p>
          <p class="h3">Когнитивно-поведенческая терапия</p>
          <p class="h4">Онлайн и в кабинете в центре города</p>
          <div class="prose type-specimen__body">
            <p>
              Я работаю с тревогой, перфекционизмом и тем самым внутренним голосом, который вечно чем-то недоволен. На первой встрече мы просто знакомимся: вы
              рассказываете, что происходит, я — как могла бы помочь. Ни к чему не обязывает.
            </p>
            <p class="small">Подпись, мелкий текст: 0,86–0,96 rem. Строка основного текста — 55–75 знаков.</p>
          </div>
        </div>

        <div class="type-side">
          <PaperCard tone="mint" tilt={1.4} class="axes">
            <h3 class="h4">Оси Geologica</h3>
            <p class="axes__sample" data-axes-sample>Мягкий заголовок</p>
            <div class="axes__controls">
              <label>
                <span>насыщенность <output data-out="wght">470</output></span>
                <input type="range" min="300" max="800" value="470" data-axis="wght" />
              </label>
              <label>
                <span>курсивность <output data-out="crsv">0</output></span>
                <input type="range" min="0" max="1" step="0.1" value="0" data-axis="crsv" />
              </label>
              <label>
                <span>наклон <output data-out="slnt">0</output></span>
                <input type="range" min="-12" max="0" value="0" data-axis="slnt" />
              </label>
            </div>
            <p class="small">На кнопках при наведении: курсивность 1, наклон −7°. Можно анимировать и на скролле.</p>
          </PaperCard>

          <div class="decision text-glow">
            <p class="hand decision__tag">запасной вариант</p>
            <p class="small">
              Если Geologica покажется слишком «технической» — <b>Manrope</b> (мягче, но без осей) или <b>Nunito Sans</b> (теплее, но ближе к «детскому»). Пока
              рекомендую остаться на Geologica: ось CRSV даёт живость, которой у других нет.
            </p>
          </div>
        </div>
      </div>
    </SgSection>

    <!-- ───────────── 03 grain ───────────── -->
    <SgSection id="grain" n="03" title="Зерно и спрей" daytime="meadow">
      <Fragment slot="intro">
        <p>
          Зерно живёт внутри шейдера и внутри цветных форм. Немногие оставшиеся плашки — гуашь без зерна: мягкие пятна плотности и чуть темнее к краю.
        </p>
      </Fragment>
      <ul class="grain-grid" role="list">
        <li>
          <div class="grain-tile grain-tile--flat" aria-hidden="true"></div>
          <p class="small">без текстуры — пластик</p>
        </li>
        <li>
          <div class="grain-tile grain-tile--paper tex-plaque" aria-hidden="true"></div>
          <p class="small">гуашь: плашки, где они нужны</p>
        </li>
        <li>
          <div class="grain-tile grain-tile--open" aria-hidden="true">
            <SprayBlob tone="orange" glow="sun" shape="b" rotate={-12} class="grain-blob" />
          </div>
          <p class="small">цветная форма: пигмент неравномерный, край распылён</p>
        </li>
        <li>
          <div class="grain-tile grain-tile--open" aria-hidden="true">
            <SprayBlob tone="sky" glow="white" shape="c" rotate={30} blur={10} class="grain-blob" />
            <SprayBlob tone="sun" glow="peach" shape="a" rotate={-8} blur={6} class="grain-blob grain-blob--small" />
          </div>
          <p class="small">расфокус: ореол вокруг размытой формы</p>
        </li>
        <li>
          <div class="grain-tile grain-tile--paper tex-plaque grain-tile--splat" aria-hidden="true">
            <Splatter seed={3} count={18} w={240} h={240} />
          </div>
          <p class="small">брызги: специи, не украшение</p>
        </li>
      </ul>
    </SgSection>

    <!-- ───────────── 04 field ───────────── -->
    <SgSection id="field" n="04" title="Живое поле и время суток" daytime="sunset">
      <Fragment slot="intro">
        <p>
          Один WebGL-холст за всем контентом: медленно текущие размытые пятна (fbm с искажением пространства), зерно внутри шейдера. Скролл — это путь через день:
          у каждой секции своя палитра, между ними цвета плавно перетекают. Около курсора — лёгкая рябь (только мышь).
        </p>
        <p class="small">
          ~30 кадров/с, разрешение рендера ≤ 1,5 DPR × 0,66, пауза в фоновой вкладке. Без WebGL — CSS-градиент той же палитры. При «уменьшении движения» — один
          статичный кадр.
        </p>
      </Fragment>

      <div class="daytimes" role="group" aria-label="Палитры времени суток">
        {
          (Object.keys(daytimes) as Daytime[]).map((d, i) => (
            <button type="button" class="daytime" data-lock={d} aria-pressed="false" style={`--tilt:${i % 2 ? 1.2 : -1.4}deg`}>
              <span class="daytime__strip" aria-hidden="true">
                {daytimes[d].map((c) => (
                  <span style={`background:${c}`} />
                ))}
              </span>
              <span class="daytime__name">{daytimeLabels[d].name}</span>
              <span class="daytime__where small">{daytimeLabels[d].where}</span>
            </button>
          ))
        }
        <button type="button" class="daytime daytime--free" data-lock="" aria-pressed="true">
          <span class="daytime__name">По скроллу</span>
          <span class="daytime__where small">как на сайте</span>
        </button>
      </div>
      <p class="hand field-hint text-glow">нажми на палитру — поле за страницей перекрасится. Подвигай мышью по пустому месту.</p>

    </SgSection>

    <!-- ───────────── 05 illustrations ───────────── -->
    <SgSection id="illustrations" n="05" title="Рисунки" daytime="sunset">
      <Fragment slot="intro">
        <p>
          Своя библиотека, нарисованная кодом: опорные точки задаются руками, потом сглаживаются и получают медленную «дрожь руки» по зерну (seed). Один маркер,
          одним движением, круглые концы, никакой идеальной геометрии. Контур «кипит» (line boil, 10 кадров/с), появляется прорисовкой, а кое-кто тихо живёт: цветок
          качается, кот машет хвостом, цапля клюёт, птичка подпрыгивает.
        </p>
      </Fragment>

      <div class="illo-actions">
        <Button variant="paper" data-replay>Нарисовать заново</Button>
      </div>

      <ul class="illo-grid" role="list">
        {
          illos.map((it, i) => (
            <li class="illo-tile" style={`--tilt:${((i * 37) % 7) - 3}deg`}>
              <SprayBlob tone={it.tile} glow={it.glow} shape={(['a', 'b', 'c'] as const)[i % 3]} rotate={i * 41} class="illo-tile__bg" />
              <Illustration name={it.name} size={150} draw class="illo-tile__art" />
              <span class="illo-tile__name hand text-glow">{it.ru}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="h3 sub-h text-glow">Один сюжет — разная рука</h3>
      <div class="variants">
        {
          [0, 1, 2, 3].map((v) => (
            <div class="variants__item">
              <SprayBlob tone={(['turquoise', 'coral', 'olive', 'lavender'] as const)[v]} glow="peach" shape="b" rotate={v * 60} class="variants__bg" />
              <Illustration name="sevenPetal" size={150} variant={v} />
            </div>
          ))
        }
      </div>
      <p class="small variants__cap text-glow">
        <code>variant</code> меняет зерно рисунка: можно поставить много цветков, и ни один не повторит другой.
      </p>
    </SgSection>

    <!-- ───────────── 06 components ───────────── -->
    <SgSection id="components" n="06" title="Компоненты" daytime="sunset">
      <Fragment slot="intro">
        <p>
          Настоящий интерфейс, но нарисованный от руки. Кнопки — кляксы. Плашки — только там, где они нужны по структуре: навигация поверх контента, вопросы,
          панели с настройками, карточки. Остальной текст лежит прямо на поле.
        </p>
      </Fragment>

      <div class="comp-block">
        <h3 class="h3 sub-h text-glow">Кнопки</h3>
        <div class="btn-row">
          <Button href={site.bookingUrl} external>Записаться</Button>
          <Button variant="paper">Подробнее</Button>
          <Button variant="paper" href="#faq-demo">К вопросам</Button>
        </div>
        <p class="small text-glow">
          Наведение: форма кляксы перетекает, буква становится курсивнее, контур «кипит». Нажатие — сплющивается. Фокус с клавиатуры — нарисованное кольцо.
        </p>
      </div>

      <div class="comp-block">
        <h3 class="h3 sub-h text-glow">Карточки</h3>
        <div class="cards">
          <PaperCard as="article" tilt={-2} tape class="card-demo">
            <div class="wobble-hover card-demo__media">
              <div class="card-demo__pic">
                <SprayBlob tone="mint" glow="sun" shape="b" class="card-demo__pic-bg" />
                <Illustration name="fern" size={110} />
              </div>
            </div>
            <h4>Гуашевая плашка</h4>
            <p class="small">Наклон, мягкие пятна краски, чуть неровный край. При наведении выпрямляется, картинка дрожит, как сквозь воду.</p>
          </PaperCard>
          <BlobCard as="article" tone="sun" glow="white" class="card-demo">
            <h4>Цветное пятно</h4>
            <p class="small">Для коротких фактов «обо мне»: распылённый край, зерно внутри, чернила сверху.</p>
          </BlobCard>
          <BlobCard as="article" tone="lavender" glow="peach" shape="panel-b" tilt={2} class="card-demo">
            <h4>Холодное пятно</h4>
            <p class="small">Холодные цвета — реже, как пауза между тёплыми.</p>
          </BlobCard>
          <div class="frost card-demo card-demo--frost">
            <h4>Матовая панель</h4>
            <p class="small">Для того, что лежит поверх контента: навигация, всплывающее.</p>
          </div>
        </div>
      </div>

      <div class="comp-block">
        <h3 class="h3 sub-h text-glow">Навигация</h3>
        <nav class="nav-demo frost" aria-label="Пример навигации">
          <HandUnderline href="#components" seed={11}>Обо мне</HandUnderline>
          <HandUnderline href="#components" seed={12} current>Подходы</HandUnderline>
          <HandUnderline href="#components" seed={13}>Запись</HandUnderline>
          <HandUnderline href="#components" seed={14}>Вопросы</HandUnderline>
        </nav>
