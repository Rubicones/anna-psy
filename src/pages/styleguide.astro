<script>
  import { replayDraw } from '~/scripts/draw-on';

  // field palette lock
  const lockBtns = document.querySelectorAll<HTMLButtonElement>('[data-lock]');
  lockBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const d = btn.dataset.lock || null;
      dispatchEvent(new CustomEvent('field:lock', { detail: d }));
      lockBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    }),
  );

  // replay draw-on
  document.querySelector('[data-replay]')?.addEventListener('click', () => {
    document.querySelectorAll('#illustrations [data-draw]').forEach((el) => replayDraw(el));
  });

  // Geologica axes playground
  const sample = document.querySelector<HTMLElement>('[data-axes-sample]');
  document.querySelectorAll<HTMLInputElement>('[data-axis]').forEach((input) =>
    input.addEventListener('input', () => {
      const axis = input.dataset.axis!;
      sample?.style.setProperty(`--${axis}`, input.value);
      const out = document.querySelector(`[data-out="${axis}"]`);
      if (out) out.textContent = input.value;
    }),
  );
</script>

